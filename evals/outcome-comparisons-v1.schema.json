{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimiflow.local/schemas/outcome-comparisons-v1.schema.json",
  "title": "Kimiflow paired outcome comparison row v1",
  "description": "Closed structural contract for one Plain-vs-Kimiflow comparison. Cross-field, lifecycle, dataset-identity and repository Evidence checks are authoritative in hooks/kimiflow_core/outcome_comparisons.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "task_id",
    "task",
    "repository_id",
    "source_commit",
    "source_snapshot_sha256",
    "arm_order",
    "execution_contract",
    "task_evidence",
    "source_snapshot_evidence",
    "oracle_evidence",
    "blind_review_evidence",
    "arms",
    "post_merge"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_id": {"$ref": "#/$defs/identity"},
    "task_id": {"$ref": "#/$defs/identity"},
    "task": {"$ref": "#/$defs/task"},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_commit": {"$ref": "#/$defs/commit"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "arm_order": {
      "oneOf": [
        {"const": ["plain", "kimiflow"]},
        {"const": ["kimiflow", "plain"]}
      ]
    },
    "execution_contract": {"$ref": "#/$defs/execution"},
    "task_evidence": {"$ref": "#/$defs/evidence_or_null"},
    "source_snapshot_evidence": {"$ref": "#/$defs/evidence_or_null"},
    "oracle_evidence": {"$ref": "#/$defs/evidence_or_null"},
    "blind_review_evidence": {"$ref": "#/$defs/evidence_or_null"},
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/arm"}
    },
    "post_merge": {"$ref": "#/$defs/post_merge"}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp_or_null": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "counter_or_null": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "boolean_or_null": {
      "type": ["boolean", "null"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "source_snapshot",
            "oracle",
            "blind_review",
            "session",
            "outcome",
            "diff",
            "merge",
            "post_merge"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_or_null": {
      "oneOf": [
        {"$ref": "#/$defs/evidence"},
        {"type": "null"}
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "reasoning_effort",
        "toolset_fingerprint",
        "permission_fingerprint",
        "execution_fingerprint",
        "time_budget_seconds",
        "token_budget"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "toolset_fingerprint": {"$ref": "#/$defs/sha256"},
        "permission_fingerprint": {"$ref": "#/$defs/sha256"},
        "execution_fingerprint": {"$ref": "#/$defs/sha256"},
        "time_budget_seconds": {"type": "integer", "minimum": 1},
        "token_budget": {"type": "integer", "minimum": 1}
      }
    },
    "defects_or_null": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocker", "high"],
          "properties": {
            "blocker": {"$ref": "#/$defs/counter_or_null"},
            "high": {"$ref": "#/$defs/counter_or_null"}
          }
        },
        {"type": "null"}
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text_sha256"],
      "properties": {
        "kind": {"enum": ["bug", "feature"]},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "post_merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "window_days", "observed_at"],
      "properties": {
        "status": {"enum": ["pending", "observed", "not_applicable"]},
        "window_days": {"type": ["integer", "null"], "minimum": 7, "maximum": 30},
        "observed_at": {"$ref": "#/$defs/timestamp_or_null"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "measurement_source",
        "session_id",
        "source_commit",
        "source_snapshot_sha256",
        "execution",
        "started_at",
        "completed_at",
        "completed",
        "accepted",
        "internal_defects",
        "residual_defects",
        "input_tokens",
        "output_tokens",
        "model_calls",
        "tool_calls",
        "user_interactions",
        "rework_rounds",
        "confounds",
        "added_loc",
        "deleted_loc",
        "session_evidence",
        "outcome_evidence",
        "diff_evidence",
        "merge_status",
        "merged_at",
        "merge_commit",
        "window_ends_at",
        "merge_evidence",
        "post_merge_defects",
        "post_merge_evidence"
      ],
      "properties": {
        "name": {"enum": ["plain", "kimiflow"]},
        "measurement_source": {"enum": ["actual", "estimated", "missing"]},
        "session_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "execution": {"$ref": "#/$defs/execution"},
        "started_at": {"$ref": "#/$defs/timestamp_or_null"},
        "completed_at": {"$ref": "#/$defs/timestamp_or_null"},
        "completed": {"$ref": "#/$defs/boolean_or_null"},
        "accepted": {"$ref": "#/$defs/boolean_or_null"},
        "internal_defects": {"$ref": "#/$defs/defects_or_null"},
        "residual_defects": {"$ref": "#/$defs/defects_or_null"},
        "input_tokens": {"$ref": "#/$defs/counter_or_null"},
        "output_tokens": {"$ref": "#/$defs/counter_or_null"},
        "model_calls": {"$ref": "#/$defs/counter_or_null"},
        "tool_calls": {"$ref": "#/$defs/counter_or_null"},
        "user_interactions": {"$ref": "#/$defs/counter_or_null"},
        "rework_rounds": {"$ref": "#/$defs/counter_or_null"},
        "confounds": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          ]
        },
        "added_loc": {"$ref": "#/$defs/counter_or_null"},
        "deleted_loc": {"$ref": "#/$defs/counter_or_null"},
        "session_evidence": {"$ref": "#/$defs/evidence_or_null"},
        "outcome_evidence": {"$ref": "#/$defs/evidence_or_null"},
        "diff_evidence": {"$ref": "#/$defs/evidence_or_null"},
        "merge_status": {"enum": ["merged", "not_merged"]},
        "merged_at": {"$ref": "#/$defs/timestamp_or_null"},
        "merge_commit": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "window_ends_at": {"$ref": "#/$defs/timestamp_or_null"},
        "merge_evidence": {"$ref": "#/$defs/evidence_or_null"},
        "post_merge_defects": {"$ref": "#/$defs/defects_or_null"},
        "post_merge_evidence": {"$ref": "#/$defs/evidence_or_null"}
      }
    }
  }
}
