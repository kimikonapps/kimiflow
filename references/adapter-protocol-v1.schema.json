{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimikonapps/kimiflow/references/adapter-protocol-v1.schema.json",
  "title": "Kimiflow command-adapter protocol v1",
  "type": "object",
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "files": {"const": true},
        "shell": {"const": true},
        "tests": {"const": true},
        "resume": {"const": true},
        "gates": {"const": true}
      },
      "required": ["files", "shell", "tests", "resume", "gates"],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "workflow_context": {"type": "boolean"},
        "model_roles": {"type": "boolean"},
        "structured_events": {"type": "boolean"},
        "root_confinement": {"type": "boolean"},
        "context_rollover": {"type": "boolean"},
        "adaptive_model_routes": {"type": "boolean"},
        "adaptive_execution_profiles": {"type": "boolean"},
        "work_unit_policy": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"context_rollover": {"const": true}},
            "required": ["context_rollover"]
          },
          "then": {
            "properties": {"structured_events": {"const": true}},
            "required": ["structured_events"]
          }
        },
        {
          "if": {
            "properties": {"adaptive_model_routes": {"const": true}},
            "required": ["adaptive_model_routes"]
          },
          "then": {
            "properties": {"model_roles": {"const": true}},
            "required": ["model_roles"]
          }
        }
      ],
      "additionalProperties": false
    },
    "adapterInfo": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "name": {"$ref": "#/$defs/identity"},
        "host": {"$ref": "#/$defs/identity"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "features": {"$ref": "#/$defs/features"},
        "execution_profile": {"$ref": "#/$defs/executionProfile"}
      },
      "required": ["schema_version", "name", "host", "capabilities"],
      "additionalProperties": true
    },
    "executionVariant": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "default": {"type": "boolean"},
        "cost_rank": {"type": "integer", "minimum": 0, "maximum": 100},
        "depth_rank": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "required": ["id", "default"],
      "additionalProperties": false
    },
    "executionControls": {
      "type": "object",
      "properties": {
        "thinking": {"enum": ["unavailable", "fixed_on", "fixed_off", "selectable", "adaptive_default"]},
        "task_budget": {"type": "boolean"},
        "prompt_cache": {"type": "boolean"},
        "compaction": {"type": "boolean"},
        "structured_failures": {"type": "boolean"}
      },
      "required": ["thinking", "task_budget", "prompt_cache", "compaction", "structured_failures"],
      "additionalProperties": false
    },
    "executionProfile": {
      "type": "object",
      "$comment": "Runtime requires exactly one default variant and unique variant IDs.",
      "properties": {
        "schema_version": {"const": 1},
        "model_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000000},
        "execution_variants": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/executionVariant"}},
        "controls": {"$ref": "#/$defs/executionControls"}
      },
      "required": ["schema_version", "model_fingerprint", "max_input_tokens", "max_output_tokens", "execution_variants", "controls"],
      "additionalProperties": false
    },
    "executionProfileSelection": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "profile_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_variant": {"$ref": "#/$defs/identity"},
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000000},
        "controls": {"$ref": "#/$defs/executionControls"}
      },
      "required": ["schema_version", "profile_fingerprint", "model_fingerprint", "execution_variant", "max_input_tokens", "max_output_tokens", "controls"],
      "additionalProperties": false
    },
    "modelRouting": {
      "type": "object",
      "properties": {
        "default_model": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "roles": {
          "type": "object",
          "properties": {
            "top": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "balanced": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "cheap": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "cross_family_top": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "candidates": {
          "type": "object",
          "properties": {
            "top": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "balanced": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "cheap": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "cross_family_top": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "status": {"enum": ["resolved", "fallback"]},
            "risk": {"enum": ["routine", "critical"]},
            "decisions": {"type": "object"}
          },
          "required": ["status", "risk", "decisions"],
          "additionalProperties": false
        }
      },
      "required": ["roles"],
      "additionalProperties": false
    },
    "modelRoute": {
      "type": "object",
      "$comment": "Runtime additionally requires model != baseline and exact matches to model_routing.candidates[role] and model_routing.roles.top.",
      "properties": {
        "role": {"enum": ["balanced", "cheap"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "baseline": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}
      },
      "required": ["role", "model", "baseline"],
      "additionalProperties": false
    },
    "rolloverArtifact": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["phase", "reference", "artifact"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["kind", "name", "bytes", "sha256"],
      "additionalProperties": false
    },
    "contextRollover": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "rollover_id": {"type": "string", "pattern": "^roll_[0-9a-f]{32}$"},
        "current_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "phase": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
        "reason": {"type": ["string", "null"]},
        "retained": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/rolloverArtifact"}}
      },
      "required": ["schema_version", "rollover_id", "current_digest", "phase", "reason", "retained"],
      "additionalProperties": false
    },
    "workflowContext": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "name": {"const": "kimiflow"},
        "plugin_root": {"type": "string", "minLength": 1},
        "skill": {"const": "SKILL.md"},
        "phase_manifest": {"const": "phases/PHASES.json"},
        "run_bridge": {"const": "hooks/run-bridge.sh"}
      },
      "required": ["schema_version", "name", "plugin_root", "skill", "phase_manifest", "run_bridge"],
      "additionalProperties": false
    },
    "workUnitPolicy": {
      "type": "object",
      "$comment": "context_scope=sealed_input is a cooperative attestation of no filesystem access, no tools, no resume, and no provider-side prompt/response persistence.",
      "properties": {
        "schema_version": {"const": 1},
        "unit_kind": {"enum": ["research", "review", "solution_candidate", "solution_selector"]},
        "context_scope": {"enum": ["project_root", "sealed_input"]},
        "filesystem_access": {"enum": ["read_only", "none"]},
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}
        },
        "settings_sources": {"type": "array", "maxItems": 0},
        "mcp_servers": {"type": "array", "maxItems": 0},
        "hooks": {"const": false},
        "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"context_scope": {"const": "sealed_input"}}, "required": ["context_scope"]},
          "then": {
            "properties": {
              "filesystem_access": {"const": "none"},
              "allowed_tools": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"context_scope": {"const": "project_root"}}, "required": ["context_scope"]},
          "then": {"properties": {"filesystem_access": {"const": "read_only"}}}
        },
        {
          "if": {
            "properties": {
              "unit_kind": {
                "enum": ["solution_candidate", "solution_selector"]
              }
            },
            "required": ["unit_kind"]
          },
          "then": {
            "properties": {
              "context_scope": {"const": "sealed_input"},
              "filesystem_access": {"const": "none"},
              "allowed_tools": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit_kind": {"enum": ["research", "review"]}
            },
            "required": ["unit_kind"]
          },
          "then": {
            "properties": {
              "context_scope": {"const": "project_root"},
              "filesystem_access": {"const": "read_only"},
              "allowed_tools": {
                "items": {
                  "enum": ["Read", "Glob", "Grep", "WebFetch", "WebSearch"]
                }
              }
            }
          }
        }
      ],
      "required": ["schema_version", "unit_kind", "context_scope", "filesystem_access", "allowed_tools", "settings_sources", "mcp_servers", "hooks", "input_digest"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      },
      "required": ["model_calls", "tool_calls", "input_tokens", "output_tokens"],
      "additionalProperties": false
    },
    "usageV2Counter": {
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 10000000000},
        {"const": "unavailable"}
      ]
    },
    "usageV2": {
      "type": "object",
      "$comment": "Runtime requires logical_input_tokens = uncached + cache_read + cache_creation and active <= peak <= max_input when all counters are available.",
      "properties": {
        "schema_version": {"const": 2},
        "turn_id": {"type": "string", "pattern": "^turn_[A-Za-z0-9._:-]{1,96}$"},
        "session_id": {"$ref": "#/$defs/sessionId"},
        "model_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_variant": {"$ref": "#/$defs/identity"},
        "model_calls": {"$ref": "#/$defs/usageV2Counter"},
        "tool_calls": {"$ref": "#/$defs/usageV2Counter"},
        "uncached_input_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "cache_read_input_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "logical_input_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "output_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "active_context_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "peak_context_tokens": {"$ref": "#/$defs/usageV2Counter"},
        "max_input_tokens": {"$ref": "#/$defs/usageV2Counter"}
      },
      "required": ["schema_version", "turn_id", "session_id", "model_fingerprint", "execution_variant", "model_calls", "tool_calls", "uncached_input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "logical_input_tokens", "output_tokens", "active_context_tokens", "peak_context_tokens", "max_input_tokens"],
      "additionalProperties": false
    },
    "turnRequest": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "action": {"enum": ["start", "resume"]},
        "root": {"type": "string", "minLength": 1},
        "session_id": {"anyOf": [{"$ref": "#/$defs/sessionId"}, {"type": "null"}]},
        "host": {"$ref": "#/$defs/identity"},
        "adapter": {"$ref": "#/$defs/identity"},
        "prompt": {"type": "string", "minLength": 1},
        "model": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}, {"type": "null"}]},
        "required_capabilities": {
          "const": ["files", "shell", "tests", "resume", "gates"]
        },
        "workflow_context": {"$ref": "#/$defs/workflowContext"},
        "model_routing": {"$ref": "#/$defs/modelRouting"},
        "context_rollover": {"$ref": "#/$defs/contextRollover"},
        "execution_profile": {"$ref": "#/$defs/executionProfileSelection"},
        "work_unit_policy": {"$ref": "#/$defs/workUnitPolicy"}
      },
      "required": ["schema_version", "action", "root", "session_id", "host", "adapter", "prompt", "model", "required_capabilities"],
      "allOf": [
        {
          "if": {
            "properties": {
              "work_unit_policy": {
                "properties": {"context_scope": {"const": "sealed_input"}},
                "required": ["context_scope"]
              }
            },
            "required": ["work_unit_policy"]
          },
          "then": {
            "properties": {
              "action": {"const": "start"},
              "session_id": {"type": "null"}
            },
            "not": {
              "anyOf": [
                {"required": ["workflow_context"]},
                {"required": ["model_routing"]},
                {"required": ["context_rollover"]},
                {"required": ["execution_profile"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "runResult": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "type": {"const": "run.result"},
        "result": {
          "type": "object",
          "properties": {
            "schema_version": {"const": 1},
            "status": {"type": "string", "minLength": 1},
            "error": {"type": "string"}
          },
          "required": ["schema_version", "status"],
          "additionalProperties": true
        }
      },
      "required": ["schema_version", "type", "result"],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {"type": "object", "properties": {"type": {"const": "session.started"}, "session_id": {"$ref": "#/$defs/sessionId"}}, "required": ["type", "session_id"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "message"}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}, "required": ["type", "text"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"enum": ["turn.failed", "error"]}, "error_code": {"enum": ["turn_cancelled", "refusal", "quota_exceeded", "turn_timeout", "provider_crash"]}}, "required": ["type"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "turn.completed"}, "usage": {"$ref": "#/$defs/usage"}, "usage_v2": {"$ref": "#/$defs/usageV2"}, "model_route": {"$ref": "#/$defs/modelRoute"}}, "required": ["type"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "phase.changed"}, "phase": {"type": "integer", "minimum": 0, "maximum": 7}, "status": {"enum": ["started", "completed", "blocked"]}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}, "required": ["type", "phase", "status"], "additionalProperties": true},
        {"type": "object", "$comment": "Runtime additionally requires total >= current when total is present.", "properties": {"type": {"const": "progress"}, "current": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "total": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}, "required": ["type", "current"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "tool.started"}, "tool": {"$ref": "#/$defs/identity"}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}, "required": ["type", "tool"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "tool.completed"}, "tool": {"$ref": "#/$defs/identity"}, "status": {"enum": ["passed", "failed", "cancelled"]}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}, "required": ["type", "tool", "status"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "test.completed"}, "name": {"type": "string", "minLength": 1, "maxLength": 240}, "status": {"enum": ["passed", "failed", "skipped"]}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}}, "required": ["type", "name", "status"], "additionalProperties": true},
        {"type": "object", "properties": {"type": {"const": "user_input.requested"}, "kind": {"$ref": "#/$defs/identity"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}}, "required": ["type", "kind", "summary"], "additionalProperties": true},
        {"type": "object", "$comment": "Runtime additionally requires after_tokens <= before_tokens. Legacy token-only events remain valid telemetry; rollover acknowledgement requires both exact identity fields.", "properties": {"type": {"const": "context.compacted"}, "rollover_id": {"type": "string", "pattern": "^roll_[0-9a-f]{32}$"}, "current_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "before_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000000}, "after_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000000}}, "required": ["type", "before_tokens", "after_tokens"], "dependentRequired": {"rollover_id": ["current_digest"], "current_digest": ["rollover_id"]}, "additionalProperties": true}
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/adapterInfo"},
    {"$ref": "#/$defs/turnRequest"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/runResult"}
  ]
}
