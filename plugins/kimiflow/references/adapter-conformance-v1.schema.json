{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimiflow.local/schemas/adapter-conformance-v1.schema.json",
  "title": "Kimiflow adapter conformance receipt v1",
  "type": "object",
  "required": ["schema_version", "status", "adapter", "host", "contract_fingerprint", "capabilities", "features", "assurance", "claims", "checks", "failed_checks"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["compatible", "incompatible"]},
    "adapter": {"type": "string"},
    "host": {"type": "string"},
    "contract_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assurance": {
      "type": "object",
      "required": ["mode", "host_trust_required", "os_process_attestation"],
      "properties": {
        "mode": {"const": "cooperative_black_box"},
        "host_trust_required": {"const": true},
        "os_process_attestation": {"const": false}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "required": ["crash_resume", "refusal", "quota", "cancel", "process_group_reaping", "root_confinement"],
      "properties": {
        "crash_resume": {"const": "deterministic_fixture"},
        "refusal": {"const": "deterministic_fixture"},
        "quota": {"const": "deterministic_fixture"},
        "cancel": {"const": "deterministic_fixture"},
        "process_group_reaping": {"const": "controller_enforced"},
        "root_confinement": {"const": "cooperative_claim"}
      },
      "additionalProperties": false
    },
    "checks": {"type": "object", "additionalProperties": {"enum": ["passed", "failed", "not_claimed", "controller_enforced", "fixture_contract", "cooperative"]}},
    "failed_checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
