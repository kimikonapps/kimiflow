{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimiflow.local/schemas/security-eval-v1.schema.json",
  "title": "Kimiflow Security Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_fingerprint", "metrics", "expected_metrics", "samples", "fixture_digest", "evidence_digest", "seal"],
  "properties": {"schema_version": {"const": 1}, "contract_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "metrics": {"$ref": "#/$defs/metrics"}, "expected_metrics": {"$ref": "#/$defs/metrics"}, "samples": {"$ref": "#/$defs/samples"}, "fixture_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "seal": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "$defs": {"metrics": {"type": "object", "additionalProperties": false, "required": ["threat_model_coverage", "finding_precision", "reachability", "refusal_fallback", "fix_verification", "false_clean_prevention", "token_cost"], "properties": {"threat_model_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "finding_precision": {"type": "number", "minimum": 0, "maximum": 1}, "reachability": {"type": "number", "minimum": 0, "maximum": 1}, "refusal_fallback": {"type": "number", "minimum": 0, "maximum": 1}, "fix_verification": {"type": "number", "minimum": 0, "maximum": 1}, "false_clean_prevention": {"type": "number", "minimum": 0, "maximum": 1}, "token_cost": {"type": "integer", "minimum": 0}}}, "samples": {"type": "object", "additionalProperties": false, "required": ["threat_model_coverage", "finding_precision", "reachability", "refusal_fallback", "fix_verification", "false_clean_prevention", "token_cost"], "properties": {"threat_model_coverage": {"type": "integer", "minimum": 1}, "finding_precision": {"type": "integer", "minimum": 1}, "reachability": {"type": "integer", "minimum": 1}, "refusal_fallback": {"type": "integer", "minimum": 1}, "fix_verification": {"type": "integer", "minimum": 1}, "false_clean_prevention": {"type": "integer", "minimum": 1}, "token_cost": {"type": "integer", "minimum": 1}}}}
}
